{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Paint",
  "mainBinaryName": "paint",
  "version": "../../package.json",
  "identifier": "se.niclaslindstedt.paint",
  "build": {
    "frontendDist": "./placeholder"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "app", "dmg", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../webroot": "webroot"
    },
    "category": "Graphics and Design",
    "shortDescription": "a local-first sketchpad",
    "longDescription": "A local-first paint app: a simple canvas for sketching concepts, with pluggable tools you switch on in settings, themes, namespaces and optional cloud sync. Your drawings stay on your machine.",
    "copyright": "Copyright © Niclas Lindstedt",
    "macOS": {
      "entitlements": "entitlements.mac.plist",
      "minimumSystemVersion": "10.15"
    }
  }
}
